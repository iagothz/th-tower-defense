root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = intellij_idea
max_line_length = 200
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[core/src/main/kotlin/com/iagothz/mergetd/ui/{Strings,DieTextsEn,TipsEn,DieInfo}.kt]
max_line_length = off

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
